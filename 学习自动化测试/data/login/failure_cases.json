  {
    "description": "登录失败场景测试数据",
    "cases": [
      {
        "id": "wrong_password",
        "title": "密码错误",
        "request": {"username": "admin", "password": "wrong12"},
        "expect": {"code": 400, "msg_contains": "密码错误"}
      },
      {
        "id": "empty_username",
        "title": "空用户名",
        "request": {"username": "", "password": "123456"},
        "expect": {"code": 422, "msg_contains": "用户名长度不能少于1个字符"}
      },
      {
        "id": "short_password",
        "title": "密码太短",
        "request": {"username": "admin", "password": "12"},
        "expect": {"code": 422,"msg_contains":"密码长度不能少于6个字符"}
      },
      {
        "id": "nonexistent_user",
        "title": "用户不存在",
        "request": {"username": "user_not_exist_999", "password": "test123456"},
        "expect": {"code": 400, "msg_contains": "不存在"}
      },
      {
        "id": "special_chars",
        "title": "用户名含特殊字符",
        "request": {"username": "admin@#$", "password": "123456"},
        "expect": {"code": 422, "msg_contains":"用户名只能包含字母、数字、下划线和中文"}
      }
    ]
  }