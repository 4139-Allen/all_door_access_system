# Stage 1: 构建前端
FROM node:20-alpine AS builder
WORKDIR /app

# 先复制依赖文件（利用 Docker 缓存层）
COPY package.json ./
RUN npm install

# 复制源码并构建
COPY . .
RUN npm run build

# Stage 2: Nginx 运行
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
