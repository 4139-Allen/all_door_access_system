# ==================== JWT 认证配置 ====================
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=3600

# ==================== 管理员初始化配置 ====================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
AUTO_CREATE_ADMIN=true

# ==================== AI 配置（可选）====================
# 不配置 DEEPSEEK_API_KEY 不影响系统启动，AI 功能不可用
DEEPSEEK_API_KEY=your-deepseek-api-key-here
AI_API_URL=https://api.deepseek.com/v1/chat/completions
AI_MODEL=deepseek-v4-flash
AI_TIMEOUT=15
AI_TEMPERATURE=0.1

# ==================== 数据库配置 ====================
# 本地开发：MYSQL_HOST=localhost
# Docker 部署：MYSQL_HOST=mysql（docker-compose 中的服务名）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DB=door_access_system

# ==================== Redis 配置 ====================
# 本地开发：REDIS_HOST=127.0.0.1
# Docker 部署：REDIS_HOST=redis（docker-compose 中的服务名）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=                 # 可选，启用需取消注释并设置密码

# ==================== CORS 跨域配置 ====================
# 本地开发：http://localhost:5173
# Docker 部署：http://localhost（加逗号多个）
# 生产环境：https://your-domain.com
ALLOWED_ORIGINS=http://localhost:5173

# ==================== MQTT 配置 ====================
# 本地开发：MQTT_BROKER_HOST=127.0.0.1
# Docker 部署：MQTT_BROKER_HOST=mosquitto（docker-compose 中的服务名）
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=door
MQTT_USERNAME=admin
MQTT_PASSWORD=change-this-password
