# 1.指定基础镜像：python 3.11 精简版约120MB，完整版900MB
FROM python:3.11-slim

#2.设置容器内的工作目录，用于存放脚本和依赖
WORKDIR /app

# 安装 curl 用于健康检查，安装 tzdata 设置时区为上海
RUN apt-get update && apt-get install -y --no-install-recommends curl tzdata && \
    rm -rf /var/lib/apt/lists/* && \
    ln -snf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone

ENV TZ=Asia/Shanghai

# 先复制依赖文件（利用 Docker 缓存层）
COPY requirements.txt .

# 加上 --trusted-host 忽略网络校验问题
RUN pip install --no-cache-dir -r requirements.txt --trusted-host pypi.org --trusted-host files.pythonhosted.org

# 把【构建上下文里当前目录】的全部文件，复制到容器内镜像的【工作目录】
COPY . .

# 暴露端口
EXPOSE 8000


CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]