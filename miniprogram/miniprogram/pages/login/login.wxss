.login-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx 80rpx;
  background: #f1f5f9;
}

/* Logo */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.logo-icon {
  width: 120rpx;
  height: 120rpx;
  background: #000;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.lock-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.lock-shackle {
  width: 44rpx;
  height: 32rpx;
  border: 5rpx solid #fff;
  border-bottom: none;
  border-radius: 22rpx 22rpx 0 0;
}

.lock-body {
  width: 56rpx;
  height: 44rpx;
  background: #fff;
  border-radius: 8rpx;
  position: relative;
}

.lock-body::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 14rpx;
  height: 18rpx;
  background: #000;
  border-radius: 0 0 7rpx 7rpx;
}

.logo-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 8rpx;
}

.logo-sub {
  font-size: 24rpx;
  color: #94a3b8;
}

/* 微信登录按钮 */
.wx-login-section {
  width: 100%;
}

.wx-login-btn {
  width: 100%;
  height: 88rpx;
  background: #07c160;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin-bottom: 32rpx;
}

.wx-login-btn:active {
  background: #06ad56;
}

/* 账号密码表单 */
.password-form {
  width: 100%;
}

.form-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}

.form-label {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 8rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 64rpx;
  font-size: 30rpx;
  color: #1e293b;
  border: none;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  background: #6366f1;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin-top: 32rpx;
}

.login-btn:active {
  background: #4f46e5;
}

/* 切换按钮 */
.switch-btn {
  text-align: center;
  padding: 24rpx 0;
}

.text-muted {
  color: #94a3b8;
  font-size: 26rpx;
}
