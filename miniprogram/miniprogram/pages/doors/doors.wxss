.doors-page {
  padding: 24rpx 32rpx;
  min-height: 100vh;
}

/* 统计卡片 */
.stats-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.stat-card {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #6366f1;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #64748b;
}

/* 区域标题 */
.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 24rpx;
}

.loading {
  text-align: center;
  padding: 80rpx 0;
}

.device-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.device-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.device-info {
  flex: 1;
  min-width: 0;
}

.device-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.device-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
}

.device-location {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-meta {
  margin-top: 4rpx;
}

.meta-text {
  font-size: 22rpx;
  color: #94a3b8;
}

.device-status {
  font-size: 22rpx;
  font-weight: 500;
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.status-online {
  color: #16a34a;
  background: #dcfce7;
}

.status-offline {
  color: #dc2626;
  background: #fee2e2;
}

.device-action {
  margin-left: 20rpx;
  flex-shrink: 0;
}

.open-btn {
  background: #6366f1 !important;
  color: #fff !important;
  font-size: 26rpx;
  font-weight: 500;
  padding: 16rpx 32rpx;
  border-radius: 12rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 160rpx;
}

.open-btn:active {
  background: #4f46e5 !important;
}

.open-btn.disabled {
  background: #e2e8f0 !important;
  color: #94a3b8 !important;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #1e293b;
  margin-bottom: 8rpx;
}

.login-hint {
  margin-top: 32rpx;
  width: auto;
  padding: 16rpx 48rpx;
}
